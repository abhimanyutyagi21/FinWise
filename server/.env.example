# --- Required ---
# Neon: Console > your project > Connect. Turn "Connection pooling" ON and copy the string
# (the host contains "-pooler"). The app uses this at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon: the same string with pooling OFF (no "-pooler"). Used only to run migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# --- Optional ---
PORT=4000
NODE_ENV=development
# Browser origin(s) allowed to call the API with cookies (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# TLS is switched on automatically for *.neon.tech. Set true for other hosted Postgres that needs it.
DATABASE_SSL=false
# Client-side pool size (Neon's pooler already shares connections, so keep this small)
DB_POOL_MAX=5
# --- AI analysis (optional) ---
# Providers are tried in this order; only providers that have a key are used. If one is busy,
# out of quota or rejects the key, the next one answers.
AI_PROVIDERS=groq,gemini
# Groq (free plan): create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Gemini thinking: Gemini 3 models use a level (default "low"); 2.5 Flash models use a token budget (default 0 = off).
# GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=0
# Milliseconds to wait for one AI attempt before moving on
# AI_TIMEOUT_MS=25000
